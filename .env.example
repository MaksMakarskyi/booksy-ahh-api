APP_ENV="development"
PORT="8080"

DATABASE_URL="file:data/hardware-hub.db?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)"

GOOSE_DRIVER="sqlite3"
GOOSE_DBSTRING="file:data/hardware-hub.db?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)"
GOOSE_MIGRATION_DIR="./migrations"
GOOSE_TABLE="goose_migrations"

OPENAI_API_KEY=""
OPENAI_EMBEDDINGS_MODEL="text-embedding-3-small"

EMBEDDINGS_MODEL_DIM="512"

SEARCH_TOP_K="5"

CORS_ORIGINS="*"

RATE_LIMIT_RPS="15"

JWT_SECRET="" # random 48-byte base64 string
JWT_TTL="12h"

ADMINS="" # JSON array of admin objects with email, full_name, and password